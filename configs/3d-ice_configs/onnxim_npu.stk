material silicon :
    thermal conductivity     1.30e-04 ;
    volumetric heat capacity 1.628e-12 ;

material lpddr_silicon :
    thermal conductivity     1.48e-04 ;
    volumetric heat capacity 1.660e-12 ;

material beol :
    thermal conductivity     2.25e-06 ;
    volumetric heat capacity 2.175e-12 ;

top heat sink :
    heat transfer coefficient 1.0e-04 ;
    temperature               313.15 ;

dimensions :
    chip length 10000 , width 10000 ;
    cell length  100 , width  100 ;

die core_die :
    layer  50 silicon ;
    layer  10 beol    ;
    source  2 silicon ;
    layer  27 beol    ;

stack :
    die SYSTEM core_die floorplan "core_die.flp" ;

solver :
    transient step 2.5e-6 , slot 2.5e-6 ;
    initial temperature 313.15 ;

output :
    Tflp ( SYSTEM , "system_temps.txt" , maximum , final ) ;